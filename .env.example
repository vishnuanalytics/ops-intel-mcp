# Supply Chain Digital Twin (all three required to enable the supply_chain_* tools)
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
SUPPLY_CHAIN_POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require
# "Today" for contract-expiry maths on the seeded demo data (defaults to the real date)
SUPPLY_CHAIN_REFERENCE_DATE=2026-09-21

# Order Wars (enables the order_wars_* tools)
ORDER_WARS_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
ORDER_WARS_SCHEMA=order_wars

# Support Automation (enables the support_automation_* tools). Supabase → Connect →
# Session pooler URI; ideally a read-only role. Optionally pin to one tenant's UUID.
SUPPORT_AUTOMATION_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPPORT_AUTOMATION_TENANT_ID=
